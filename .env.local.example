# ---------------------------------------------------------------------------
# Server-side secrets — used ONLY by the /api/relay serverless function
# (api/relay.js). These must NOT be prefixed with VITE_: anything starting
# with VITE_ is inlined into the client bundle and shipped to the browser.
# INVOICE_MASTER_SECRET derives every invoice's private key, so leaking it
# = losing every invoice's funds. On Vercel, set these in Project Settings
# → Environment Variables (not in the repo). This file is only for local
# `vercel dev`.
# ---------------------------------------------------------------------------

# REQUIRED. The master secret every invoice keypair is derived from via
# HMAC(secret, invoiceId). Use a long, high-entropy random string.
INVOICE_MASTER_SECRET=

# OPTIONAL. A relay.link API key. Unauthenticated works for moderate
# volume; a key just raises the rate-limit ceiling.
RELAY_API_KEY=

# OPTIONAL. The public origin used to build share URLs from the
# createInvoiceUrl action. Defaults to https://www.invoices.wtf.
PUBLIC_APP_URL=

# ---------------------------------------------------------------------------
# Client-side override (optional). The frontend now defaults to calling the
# same-origin /api/relay function, so you normally leave this UNSET. Set it
# only to point the app at a separately-hosted backend (e.g. the old Cloud
# Run URL) during a split deploy or local dev.
# ---------------------------------------------------------------------------
# VITE_RELAY_API_URL=
