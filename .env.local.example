# Server-side config for the /api/relay function. Set these in your host's
# environment (or here for local `vercel dev`). Not VITE_-prefixed, so they
# are never bundled into the client.

# Required. Secret used to derive invoice deposit addresses. Keep private.
INVOICE_MASTER_SECRET=

# Optional. relay.link API key (raises rate limits).
RELAY_API_KEY=

# Optional. Public origin used for generated share links.
PUBLIC_APP_URL=

# Optional. Point the client at a different backend origin.
# VITE_RELAY_API_URL=
